# --- Brain (long-term memory) ---
BRAIN_BACKEND=neo4j            # neo4j | memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_DATABASE=neo4j

# --- LLM ---
LLM_BACKEND=litellm            # litellm | fake
STRONG_MODEL=anthropic/claude-opus-5-5
SMALL_MODEL=anthropic/claude-haiku-5-5
FALLBACK_MODEL=                # e.g. openai/gpt-4o-mini ; empty disables the fallback provider
LLM_TIMEOUT_S=30               # per attempt
LLM_TOTAL_TIMEOUT_S=60         # hard ceiling per call across retries + fallback
LLM_NUM_RETRIES=1
# Provider keys are read by LiteLLM directly:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
